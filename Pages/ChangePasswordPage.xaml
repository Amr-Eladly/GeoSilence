<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GeoSilence.Pages.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Change Password"
    BackgroundColor="{AppThemeBinding Light=#F6F7FB, Dark=#0F1115}">

    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,28" Spacing="16">
            <Border Padding="18" Background="{AppThemeBinding Light=White, Dark=#151923}" Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#232833}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Change Password" FontSize="24" FontAttributes="Bold" />
                    <Entry x:Name="CurrentPasswordEntry" Placeholder="Current Password" IsPassword="True" />
                    <Entry x:Name="NewPasswordEntry" Placeholder="New Password" IsPassword="True" />
                    <Entry x:Name="ConfirmPasswordEntry" Placeholder="Confirm New Password" IsPassword="True" />
                    <Button x:Name="SaveButton" Text="Update Password" Clicked="OnSaveClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
