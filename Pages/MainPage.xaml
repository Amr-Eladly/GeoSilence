<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pageModels="clr-namespace:GeoSilence.PageModels"
    xmlns:controls="clr-namespace:GeoSilence.Controls"
    xmlns:conv="clr-namespace:GeoSilence.Converters"
    xmlns:models="clr-namespace:GeoSilence.Models"
    xmlns:services="clr-namespace:GeoSilence.Services"
    x:Class="GeoSilence.Pages.MainPage"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <!-- MAP (background) -->
        <controls:PlaceMap
            x:Name="MainMap"
            IsShowingUser="True"
            PropertyChanged="OnMapViewportChanged"
            MapLongPressed="OnMapLongPressed"/>

        <Grid
            x:Name="SearchPanel"
            RowDefinitions="Auto,Auto,Auto,Auto"
            RowSpacing="6"
            Margin="14,12,14,0"
            VerticalOptions="Start"
            ZIndex="4">

            <Border
                x:Name="SearchBarBorder"
                Grid.Row="0"
                Background="{AppThemeBinding Light={StaticResource MapSurface}, Dark={StaticResource MapSurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource MapOutline}, Dark={StaticResource MapOutlineDark}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                HeightRequest="56"
                Shadow="0,2,8,#19000000">
                <Grid ColumnDefinitions="*,Auto">
                    <controls:SurfaceSearchBar
                        x:Name="PlaceSearchBar"
                        Placeholder="Search places..."
                        SearchButtonPressed="OnSearchSubmitted"
                        TextChanged="OnSearchTextChanged"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource MapText}, Dark={StaticResource MapTextDark}}"
                        PlaceholderColor="{AppThemeBinding Light={StaticResource MapSecondaryText}, Dark={StaticResource MapSecondaryTextDark}}"
                        CancelButtonColor="{AppThemeBinding Light={StaticResource MapSecondaryText}, Dark={StaticResource MapSecondaryTextDark}}"
                        FontFamily="OpenSansRegular"
                        FontSize="15"
                        HorizontalOptions="Fill"
                        Margin="4,0,0,0"
                        HeightRequest="56"/>
                    <ActivityIndicator
                        Grid.Column="1"
                        x:Name="SearchLoadingIndicator"
                        IsVisible="False"
                        IsRunning="False"
                        WidthRequest="20"
                        HeightRequest="20"
                        Margin="0,0,6,0"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Color="{StaticResource MapPrimary}"/>

                </Grid>
            </Border>

            <Border Grid.Row="1" HorizontalOptions="Center" Padding="4"
                    Background="{AppThemeBinding Light={StaticResource MapSurface}, Dark={StaticResource MapSurfaceDark}}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 22">
                <HorizontalStackLayout Spacing="4">
                    <Button x:Name="MyPlacesModeButton" Text="My places" Clicked="OnMyPlacesModeClicked"
                            FontSize="13" Padding="16,6" CornerRadius="18" HeightRequest="40"
                            BackgroundColor="{StaticResource MapPrimary}" TextColor="White"/>
                    <Button x:Name="ExploreModeButton" Text="Explore" Clicked="OnExploreModeClicked"
                            FontSize="13" Padding="16,6" CornerRadius="18" HeightRequest="40"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource MapText}, Dark={StaticResource MapTextDark}}"/>
                </HorizontalStackLayout>
            </Border>
            <ActivityIndicator x:Name="ExploreLoading" Grid.Row="3"
                               IsVisible="False" IsRunning="False"
                               Color="#0F766E" WidthRequest="36" HeightRequest="36"
                               HorizontalOptions="Center"
                               SemanticProperties.Description="Loading public places"/>
            <Border
                x:Name="SearchSuggestionsPanel"
                Grid.Row="2"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light={StaticResource MapSurface}, Dark={StaticResource MapSurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource MapOutline}, Dark={StaticResource MapOutlineDark}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Shadow="0,3,12,#26000000">
                <ScrollView MaximumHeightRequest="300">
                    <VerticalStackLayout
                        x:Name="SearchSuggestionsList"
                        BindableLayout.ItemsSource="{Binding Source={x:Reference SearchSuggestionsPanel}, Path=BindingContext}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="services:PlaceSuggestion">
                                <Grid Padding="16,11" RowDefinitions="Auto,Auto" RowSpacing="2">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSuggestionTapped"/>
                                    </Grid.GestureRecognizers>
                                    <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource MapText}, Dark={StaticResource MapTextDark}}"/>
                                    <Label Grid.Row="1" Text="{Binding Description}" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource MapSecondaryText}, Dark={StaticResource MapSecondaryTextDark}}"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>

        </Grid>

        <VerticalStackLayout
            HorizontalOptions="End"
            VerticalOptions="End"
            x:Name="MapControls"
            Margin="0,0,18,116"
            Spacing="12"
            ZIndex="2">
            <ImageButton
                x:Name="LocateMeButton"
                Source="locate_me.svg"
                SemanticProperties.Description="Recenter map on my location"
                Clicked="OnLocateMeClicked"
                WidthRequest="52"
                HeightRequest="52"
                CornerRadius="26"
                Padding="12"
                BackgroundColor="White"
                BorderWidth="0"
                Shadow="0,3,8,#26000000"/>
        </VerticalStackLayout>


        <Border
            x:Name="PlacesBottomSheet"
            Margin="0"
            Padding="18,10,18,18"
            Background="{AppThemeBinding Light={StaticResource MapSurface}, Dark={StaticResource MapSurfaceDark}}"
            StrokeThickness="0"
            HeightRequest="104"
            VerticalOptions="End"
            ZIndex="3">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28,28,0,0" />
            </Border.StrokeShape>
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
                <Grid x:Name="SheetHeader" RowDefinitions="Auto,Auto" RowSpacing="12">
                    <Grid.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="OnBottomSheetPanUpdated"/>
                        <TapGestureRecognizer Tapped="OnBottomSheetHandleTapped"/>
                    </Grid.GestureRecognizers>
                    <BoxView WidthRequest="40" HeightRequest="4" CornerRadius="2"
                             BackgroundColor="#C8C8CE" HorizontalOptions="Center"/>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Places" FontSize="27" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource MapText}, Dark={StaticResource MapTextDark}}"/>
                            <Label Text="{Binding SavedPlacesSummary}" FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource MapSecondaryText}, Dark={StaticResource MapSecondaryTextDark}}"/>
                        </VerticalStackLayout>
                        <Button x:Name="AddPlaceButton" Grid.Column="1" Text="+ Add Place" Clicked="OnAddPlaceFabClicked"
                                BackgroundColor="{StaticResource MapPrimary}" TextColor="White"
                                FontSize="14" CornerRadius="22" Padding="12,8"/>
                    </Grid>
                </Grid>
                <Grid Grid.Row="1">
                    <CollectionView x:Name="PlacesCollectionView" ItemsSource="{Binding ClosestPlaces}" SelectionMode="None"
                                    Scrolled="OnPlacesCollectionScrolled">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Place">
                                <SwipeView x:Name="PlaceSwipe" Margin="0,0,0,10"
                                           SwipeStarted="OnPlaceCardSwipeStarted" SwipeChanging="OnPlaceCardSwipeChanging" SwipeEnded="OnPlaceCardSwipeEnded"
                                           BindingContextChanged="OnPlaceCardBindingContextChanged" Unloaded="OnPlaceCardUnloaded">
                                    <SwipeView.RightItems>
                                        <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                            <SwipeItemView CommandParameter="{x:Reference PlaceSwipe}" Invoked="OnDeleteSwipe">
                                                <Grid WidthRequest="58" BackgroundColor="{StaticResource MapDanger}"><Label Text="Delete" TextColor="White" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center"/></Grid>
                                            </SwipeItemView>
                                            <SwipeItemView CommandParameter="{x:Reference PlaceSwipe}" Invoked="OnEditSwipe">
                                                <Grid WidthRequest="58" BackgroundColor="{StaticResource MapPrimary}"><Label Text="Edit" TextColor="White" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center"/></Grid>
                                            </SwipeItemView>
                                        </SwipeItems>
                                    </SwipeView.RightItems>
                                    <Border Padding="12" StrokeShape="RoundRectangle 16" StrokeThickness="1"
                                            Background="{AppThemeBinding Light={StaticResource MapSurface}, Dark={StaticResource MapSurfaceDark}}"
                                            Stroke="{AppThemeBinding Light={StaticResource MapOutline}, Dark={StaticResource MapOutlineDark}}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource MapSelectedSurface}, Dark={StaticResource MapSelectedSurfaceDark}}"/>
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource MapSelectedOutline}, Dark={StaticResource MapSelectedOutlineDark}}"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPlaceTapped"/></Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="10"
                                              BindingContextChanged="OnPlaceCardContentBindingContextChanged">
                                            <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 24"
                                                    Background="{AppThemeBinding Light={StaticResource MapIconContainer}, Dark={StaticResource MapIconContainerDark}}">
                                                <Label Text="{Binding TypeIcon}" FontSize="20" FontAutoScalingEnabled="False"
                                                       WidthRequest="40" HeightRequest="40" Padding="0" LineBreakMode="NoWrap"
                                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" MaxLines="1" LineBreakMode="TailTruncation" FontSize="16" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource MapText}, Dark={StaticResource MapTextDark}}"/>
                                                <Label Text="{Binding PlaceMetadata}" MaxLines="1" LineBreakMode="TailTruncation" FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource MapSecondaryText}, Dark={StaticResource MapSecondaryTextDark}}"/>
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2" Padding="8,4" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                                    Background="{AppThemeBinding Light={StaticResource MapSilentContainer}, Dark={StaticResource MapSilentContainerDark}}" VerticalOptions="Center">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Mode}" Value="Vibrate"><Setter Property="Background" Value="{AppThemeBinding Light={StaticResource MapVibrateContainer}, Dark={StaticResource MapVibrateContainerDark}}"/></DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Mode}" Value="Normal"><Setter Property="Background" Value="{AppThemeBinding Light={StaticResource MapRingContainer}, Dark={StaticResource MapRingContainerDark}}"/></DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="{Binding ModeLabel}" FontSize="12" TextColor="{StaticResource MapSilent}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Mode}" Value="Vibrate"><Setter Property="TextColor" Value="{StaticResource MapVibrate}"/></DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Mode}" Value="Normal"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MapRing}, Dark={StaticResource MapSecondaryTextDark}}"/></DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <VerticalStackLayout IsVisible="{Binding ShowEmptyState}" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                        <Label Text="No places yet" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource MapText}, Dark={StaticResource MapTextDark}}"/>
                        <Label Text="Add a place to automate your phone mode." FontSize="13" HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource MapSecondaryText}, Dark={StaticResource MapSecondaryTextDark}}"/>
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Border>

        <Grid
            x:Name="PlaceFormOverlay"
            IsVisible="False"
            InputTransparent="False"
            BackgroundColor="#66000000"
            ZIndex="10">

            <Frame
                x:Name="PlaceFormCard"
                Margin="16,16,16,120"
                Padding="14"
                BackgroundColor="{AppThemeBinding Light={StaticResource MapSurface}, Dark={StaticResource MapSurfaceDark}}"
                CornerRadius="20"
                HasShadow="True"
                VerticalOptions="End">

                <ScrollView MaximumHeightRequest="590">
                <VerticalStackLayout Spacing="12">
                    <Label
                        x:Name="PlaceFormTitle"
                        Text="Add Place"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource MapText}, Dark={StaticResource MapTextDark}}"/>

                    <Entry
                        x:Name="PlaceNameEntry"
                        Placeholder="Place name"
                        BackgroundColor="{AppThemeBinding Light={StaticResource MapInput}, Dark={StaticResource MapInputDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource MapText}, Dark={StaticResource MapTextDark}}"
                        PlaceholderColor="{AppThemeBinding Light={StaticResource MapSecondaryText}, Dark={StaticResource MapSecondaryTextDark}}"
                        FontSize="13"/>

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Place Type"
                            FontAttributes="Bold"
                            FontSize="12"
                            TextColor="{AppThemeBinding Light={StaticResource MapText}, Dark={StaticResource MapTextDark}}"/>

                        <Border
                            x:Name="PlaceTypeSelector"
                            BackgroundColor="{AppThemeBinding Light={StaticResource MapInput}, Dark={StaticResource MapInputDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource MapOutline}, Dark={StaticResource MapOutlineDark}}"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPlaceTypeDropdownTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    x:Name="SelectedPlaceTypeLabel"
                                    Text="👤 Other"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Light={StaticResource MapText}, Dark={StaticResource MapTextDark}}"
                                    VerticalTextAlignment="Center"/>
                                <Label
                                    Grid.Column="1"
                                    Text="▾"
                                    FontSize="18"
                                    TextColor="{AppThemeBinding Light={StaticResource MapSecondaryText}, Dark={StaticResource MapSecondaryTextDark}}"
                                    VerticalTextAlignment="Center"
                                    HorizontalTextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="PlaceTypeMenu"
                            IsVisible="False"
                            BackgroundColor="{AppThemeBinding Light={StaticResource MapSurface}, Dark={StaticResource MapSurfaceDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource MapOutline}, Dark={StaticResource MapOutlineDark}}"
                            StrokeShape="RoundRectangle 12"
                            Padding="0">
                            <CollectionView
                                x:Name="PlaceTypeOptionsList"
                                SelectionMode="Single"
                                SelectionChanged="OnPlaceTypeSelected"
                                HeightRequest="200">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12,10"
                                              ColumnDefinitions="Auto,*"
                                              ColumnSpacing="10">
                                            <Label
                                                Text="{Binding Icon}"
                                                FontSize="18"
                                                VerticalTextAlignment="Center"/>
                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Label}"
                                                FontSize="13"
                                                TextColor="{AppThemeBinding Light={StaticResource MapText}, Dark={StaticResource MapTextDark}}"
                                                VerticalTextAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Mode"
                            FontAttributes="Bold"
                            FontSize="12"
                            TextColor="{AppThemeBinding Light={StaticResource MapText}, Dark={StaticResource MapTextDark}}"/>
                        <Grid ColumnDefinitions="*,*,*"
                              ColumnSpacing="8">
                            <Button
                                x:Name="ModeSilentButton"
                                Text="Silent"
                                Clicked="OnModeButtonTapped"
                                BackgroundColor="{AppThemeBinding Light={StaticResource MapInput}, Dark={StaticResource MapInputDark}}"
                                TextColor="#DC2626"
                                FontSize="12"
                                FontAttributes="Bold"
                                HeightRequest="40"
                                CornerRadius="8"/>
                            <Button
                                x:Name="ModeVibrateButton"
                                Grid.Column="1"
                                Text="Vibrate"
                                Clicked="OnModeButtonTapped"
                                BackgroundColor="{AppThemeBinding Light={StaticResource MapInput}, Dark={StaticResource MapInputDark}}"
                                TextColor="#F59E0B"
                                FontSize="12"
                                FontAttributes="Bold"
                                HeightRequest="40"
                                CornerRadius="8"/>
                            <Button
                                x:Name="ModeNormalButton"
                                Grid.Column="2"
                                Text="Ring"
                                Clicked="OnModeButtonTapped"
                                BackgroundColor="{AppThemeBinding Light={StaticResource MapInput}, Dark={StaticResource MapInputDark}}"
                                TextColor="#16A34A"
                                FontSize="12"
                                FontAttributes="Bold"
                                HeightRequest="40"
                                CornerRadius="8"/>
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Text="Radius"
                            FontAttributes="Bold"
                            FontSize="12"
                            TextColor="{AppThemeBinding Light={StaticResource MapText}, Dark={StaticResource MapTextDark}}"/>
                            <Label
                                Grid.Column="1"
                                x:Name="RadiusValueLabel"
                                Text="50 m"
                                FontSize="12"
                                TextColor="{AppThemeBinding Light={StaticResource MapSecondaryText}, Dark={StaticResource MapSecondaryTextDark}}"/>
                        </Grid>
                        <Slider
                            x:Name="PlaceRadiusSlider"
                            Minimum="10"
                            Maximum="200"
                            Value="50"
                            ValueChanged="OnRadiusSliderValueChanged"
                            MinimumTrackColor="{StaticResource MapPrimary}"
                            MaximumTrackColor="{AppThemeBinding Light={StaticResource MapOutline}, Dark={StaticResource MapOutlineDark}}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="Activation Type"
                            FontAttributes="Bold"
                            FontSize="12"
                            TextColor="{AppThemeBinding Light={StaticResource MapText}, Dark={StaticResource MapTextDark}}"/>
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="8">
                            <Border
                                Stroke="{AppThemeBinding Light={StaticResource MapOutline}, Dark={StaticResource MapOutlineDark}}"
                                StrokeShape="RoundRectangle 12"
                                Padding="10,8">
                                <RadioButton
                                    x:Name="ActivationAutomaticRadio"
                                    GroupName="ActivationType"
                                    Content="Automatic"
                                    IsChecked="True"
                                    TextColor="{AppThemeBinding Light={StaticResource MapText}, Dark={StaticResource MapTextDark}}"
                                    FontSize="12"
                                    CheckedChanged="OnActivationTypeCheckedChanged"/>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Stroke="{AppThemeBinding Light={StaticResource MapOutline}, Dark={StaticResource MapOutlineDark}}"
                                StrokeShape="RoundRectangle 12"
                                Padding="10,8">
                                <RadioButton
                                    x:Name="ActivationConfirmRadio"
                                    GroupName="ActivationType"
                                    Content="Confirm First"
                                    TextColor="{AppThemeBinding Light={StaticResource MapText}, Dark={StaticResource MapTextDark}}"
                                    FontSize="12"
                                    CheckedChanged="OnActivationTypeCheckedChanged"/>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="Visibility"
                            FontAttributes="Bold"
                            FontSize="12"
                            TextColor="{AppThemeBinding Light={StaticResource MapText}, Dark={StaticResource MapTextDark}}"/>
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="8">
                            <Border
                                Stroke="{AppThemeBinding Light={StaticResource MapOutline}, Dark={StaticResource MapOutlineDark}}"
                                StrokeShape="RoundRectangle 12"
                                Padding="10,8">
                                <RadioButton
                                    x:Name="VisibilityPrivateRadio"
                                    GroupName="Visibility"
                                    Content="Private"
                                    IsChecked="True"
                                    TextColor="{AppThemeBinding Light={StaticResource MapText}, Dark={StaticResource MapTextDark}}"
                                    FontSize="12"
                                    CheckedChanged="OnVisibilityCheckedChanged"/>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Stroke="{AppThemeBinding Light={StaticResource MapOutline}, Dark={StaticResource MapOutlineDark}}"
                                StrokeShape="RoundRectangle 12"
                                Padding="10,8">
                                <RadioButton
                                    x:Name="VisibilityPublicRadio"
                                    GroupName="Visibility"
                                    Content="Public"
                                    TextColor="{AppThemeBinding Light={StaticResource MapText}, Dark={StaticResource MapTextDark}}"
                                    FontSize="12"
                                    CheckedChanged="OnVisibilityCheckedChanged"/>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <controls:WeeklyScheduleEditor x:Name="PlaceScheduleEditor" />

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">
                        <Button
                            x:Name="PlaceFormCancelButton"
                            Text="Cancel"
                            Clicked="OnCancelPlaceFormClicked"
                            BackgroundColor="{AppThemeBinding Light={StaticResource MapInput}, Dark={StaticResource MapInputDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource MapText}, Dark={StaticResource MapTextDark}}"
                            HeightRequest="38"
                            FontSize="13"/>

                        <Button
                            x:Name="PlaceFormSaveButton"
                            Grid.Column="1"
                            Text="Save"
                            Clicked="OnSavePlaceFormClicked"
                            BackgroundColor="{StaticResource MapPrimary}"
                            TextColor="White"
                            HeightRequest="38"
                            FontSize="13"/>
                    </Grid>
                </VerticalStackLayout>
                </ScrollView>
            </Frame>
        </Grid>

    </Grid>

</ContentPage>
