<?xml version="1.0" encoding="utf-8" ?>
<ContentPage  
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"  
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"  
    xmlns:pageModels="clr-namespace:GeoSilence.PageModels" 
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    xmlns:conv="clr-namespace:GeoSilence.Converters"
    xmlns:models="clr-namespace:GeoSilence.Models"
    x:Class="GeoSilence.Pages.MainPage"  
    x:DataType="pageModels:HomeViewModel"
    Title="GeoSilence">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <!-- MAP (background) -->
        <maps:Map 
        x:Name="MainMap"
        IsShowingUser="True"
        MapClicked="OnMapClicked"/>

        <!-- Bottom Panel -->
        <VerticalStackLayout
        BackgroundColor="White"
        Padding="15"
        Spacing="10"
        VerticalOptions="End">

            <Label 
            Text="Places Near Me"
            FontSize="20"
            FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding NearbyPlaces}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Place">

                        <SwipeView>

                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">

                                    <!-- DELETE -->
                                    <SwipeItem BackgroundColor="Red"
                   CommandParameter="{Binding .}"
                   Invoked="OnDeleteSwipe">
                                        <SwipeItem.IconImageSource>
                                            <FontImageSource 
                    Glyph="🗑"
                    Size="20"/>
                                        </SwipeItem.IconImageSource>
                                    </SwipeItem>

                                    <!-- EDIT -->
                                    <SwipeItem BackgroundColor="Yellow"
                   CommandParameter="{Binding .}"
                   Invoked="OnEditSwipe">
                                        <SwipeItem.IconImageSource>
                                            <FontImageSource 
                    Glyph="⚙️"
                    Size="20"/>
                                        </SwipeItem.IconImageSource>
                                    </SwipeItem>

                                </SwipeItems>
                            </SwipeView.RightItems>

                            <!-- CARD -->
                            <Frame Padding="10" Margin="5">
                                <HorizontalStackLayout Spacing="10">

                                    <Label 
                            Text="{Binding Name}"
                            FontSize="16" />

                                    <Label 
                            Text="{Binding DistanceFormatted}"
                            TextColor="Gray"
                            FontSize="12" />

                                    <Label 
                            Text="{Binding Mode}"
                            TextColor="Gray" />

                                </HorizontalStackLayout>
                            </Frame>

                        </SwipeView>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </Grid>

</ContentPage>