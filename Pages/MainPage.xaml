<?xml version="1.0" encoding="utf-8" ?>
<ContentPage  
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"  
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"  
    xmlns:pageModels="clr-namespace:GeoSilence.PageModels" 
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    xmlns:conv="clr-namespace:GeoSilence.Converters"
    xmlns:models="clr-namespace:GeoSilence.Models"
    x:Class="GeoSilence.Pages.MainPage"  
    x:DataType="pageModels:HomeViewModel"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <!-- MAP (background) -->
        <maps:Map 
        x:Name="MainMap"
        IsShowingUser="True"
        MapClicked="OnMapClicked"/>

        <Grid
            x:Name="SearchPanel"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="10"
            Margin="14,12,14,0"
            HeightRequest="56"
            VerticalOptions="Start"
            ZIndex="2">

            <Border
                x:Name="SearchBarBorder"
                Grid.ColumnSpan="2"
                BackgroundColor="White"
                Stroke="#E7E7E7"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18"
                HeightRequest="56"
                Shadow="0,4,14,#22000000">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <SearchBar
                        x:Name="PlaceSearchBar"
                        Placeholder="Search places..."
                        SearchButtonPressed="OnSearchSubmitted"
                        TextChanged="OnSearchTextChanged"
                        BackgroundColor="Transparent"
                        TextColor="#111827"
                        PlaceholderColor="#9CA3AF"
                        CancelButtonColor="#9CA3AF"
                        FontSize="14"
                        HorizontalOptions="Fill"
                        Margin="4,0,0,0"
                        HeightRequest="56"/>
                    <ActivityIndicator
                        Grid.Column="1"
                        x:Name="SearchLoadingIndicator"
                        IsVisible="False"
                        IsRunning="False"
                        WidthRequest="20"
                        HeightRequest="20"
                        Margin="0,0,6,0"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Color="#2563EB"/>
                    <Border
                        Grid.Column="2"
                        x:Name="AccountAvatarBorder"
                        WidthRequest="38"
                        HeightRequest="38"
                        Margin="0,5,6,5"
                        Padding="0"
                        Background="#2563EB"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 19">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAccountAvatarTapped"/>
                        </Border.GestureRecognizers>
                        <Grid>
                            <Image
                                x:Name="AccountAvatarImage"
                                IsVisible="False"
                                Aspect="AspectFill"/>
                            <Label
                                x:Name="AccountAvatarInitialsLabel"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="White"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Button
                x:Name="AddSearchResultButton"
                Grid.Column="1"
                Text="Add"
                IsVisible="False"
                Clicked="OnAddSearchResultClicked"
                VerticalOptions="Center"
                Margin="0,0,8,0"
                HeightRequest="40"
                CornerRadius="20"
                BackgroundColor="#2563EB"
                TextColor="White"
                Padding="14,0"
                ZIndex="3"/>
        </Grid>

        <VerticalStackLayout
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,18,190"
            Spacing="12"
            ZIndex="2">
            <Button
                x:Name="LocateMeButton"
                Text="🎯"
                Clicked="OnLocateMeClicked"
                WidthRequest="52"
                HeightRequest="52"
                CornerRadius="26"
                FontSize="20"
                BackgroundColor="White"
                TextColor="#111827"
                Shadow="0,4,14,#22000000"/>
            <Button
                x:Name="AddPlaceFabButton"
                Text="+"
                Clicked="OnAddPlaceFabClicked"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                FontSize="30"
                Padding="0,-2,0,0"
                BackgroundColor="#2563EB"
                TextColor="White"
                Shadow="0,8,18,#33000000"/>
        </VerticalStackLayout>

        <Frame
            x:Name="PlacesBottomSheet"
            Margin="0"
            Padding="16,8,16,14"
            BackgroundColor="White"
            CornerRadius="24"
            HasShadow="True"
            HeightRequest="160"
            VerticalOptions="End"
            ZIndex="1">

            <Frame.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnBottomSheetPanUpdated"/>
            </Frame.GestureRecognizers>

            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                <BoxView
                    x:Name="BottomSheetHandle"
                    WidthRequest="46"
                    HeightRequest="5"
                    CornerRadius="3"
                    BackgroundColor="#D6D8DE"
                    HorizontalOptions="Center">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBottomSheetHandleTapped"/>
                    </BoxView.GestureRecognizers>
                </BoxView>

                <Label
                    Grid.Row="1"
                    Text="Places Near Me"
                    FontSize="20"
                    Margin="2,0,0,2"
                    FontAttributes="Bold"/>

                <CollectionView
                    x:Name="PlacesCollectionView"
                    Grid.Row="2"
                    ItemsSource="{Binding NearbyPlaces}"
                    SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Place">

                            <SwipeView>

                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">

                                        <SwipeItemView
                                            CommandParameter="{Binding .}"
                                            Invoked="OnDeleteSwipe">
                                            <Grid
                                                WidthRequest="56"
                                                BackgroundColor="#D92D20">
                                                <Label
                                                    Text="🗑"
                                                    FontSize="16"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"/>
                                            </Grid>
                                        </SwipeItemView>

                                        <SwipeItemView
                                            CommandParameter="{Binding .}"
                                            Invoked="OnEditSwipe">
                                            <Grid
                                                WidthRequest="56"
                                                BackgroundColor="#2563EB">
                                                <Label
                                                    Text="⚙"
                                                    FontSize="16"
                                                    TextColor="White"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"/>
                                            </Grid>
                                        </SwipeItemView>

                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Grid
                                    Padding="4,8"
                                    ColumnDefinitions="*,Auto"
                                    RowDefinitions="Auto,Auto">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPlaceTapped"/>
                                    </Grid.GestureRecognizers>

                                    <Label
                                        Text="{Binding Name}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation"/>

                                    <BoxView
                                        Grid.Column="1"
                                        WidthRequest="12"
                                        HeightRequest="12"
                                        Margin="12,0,0,0"
                                        VerticalOptions="Center"
                                        HorizontalOptions="End"
                                        BackgroundColor="#DC2626"
                                        CornerRadius="6">
                                        <BoxView.Triggers>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding Mode}" Value="Vibrate">
                                                <Setter Property="BackgroundColor" Value="#F59E0B"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding Mode}" Value="Normal">
                                                <Setter Property="BackgroundColor" Value="#16A34A"/>
                                            </DataTrigger>
                                        </BoxView.Triggers>
                                    </BoxView>

                                    <Label
                                        Grid.Row="1"
                                        Text="{Binding DistanceFormatted, StringFormat='{0} away'}"
                                        TextColor="#6B7280"
                                        FontSize="12"/>
                                </Grid>

                            </SwipeView>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </Grid>
        </Frame>

        <Grid
            x:Name="PlaceFormOverlay"
            IsVisible="False"
            InputTransparent="False"
            BackgroundColor="#66000000"
            ZIndex="10">

            <Frame
                x:Name="PlaceFormCard"
                Margin="20,20,20,184"
                Padding="18"
                BackgroundColor="White"
                CornerRadius="20"
                HasShadow="True"
                VerticalOptions="End">

                <VerticalStackLayout Spacing="12">
                    <Label
                        x:Name="PlaceFormTitle"
                        Text="Add Place"
                        FontSize="20"
                        FontAttributes="Bold"/>

                    <Entry
                        x:Name="PlaceNameEntry"
                        Placeholder="Place name"
                        Focused="OnPlaceFormInputFocused"
                        Unfocused="OnPlaceFormInputUnfocused"
                        BackgroundColor="White"
                        TextColor="Black"/>

                    <VerticalStackLayout Spacing="0">
                        <Button
                            x:Name="PlaceModeButton"
                            Text="Silent"
                            Clicked="OnModeDropdownClicked"
                            BackgroundColor="White"
                            BorderColor="#DDDDDD"
                            BorderWidth="1"
                            TextColor="Black"
                            HorizontalOptions="Fill"/>

                        <HorizontalStackLayout
                            Spacing="10"
                            Padding="4,8,4,0">
                            <HorizontalStackLayout Spacing="6">
                                <BoxView
                                    WidthRequest="10"
                                    HeightRequest="10"
                                    BackgroundColor="#DC2626"
                                    CornerRadius="5"/>
                                <Label Text="Silent" FontSize="12" TextColor="#6B7280" VerticalTextAlignment="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6">
                                <BoxView
                                    WidthRequest="10"
                                    HeightRequest="10"
                                    BackgroundColor="#F59E0B"
                                    CornerRadius="5"/>
                                <Label Text="Vibrate" FontSize="12" TextColor="#6B7280" VerticalTextAlignment="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6">
                                <BoxView
                                    WidthRequest="10"
                                    HeightRequest="10"
                                    BackgroundColor="#16A34A"
                                    CornerRadius="5"/>
                                <Label Text="Normal" FontSize="12" TextColor="#6B7280" VerticalTextAlignment="Center"/>
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>

                        <VerticalStackLayout
                            x:Name="PlaceModeDropdown"
                            IsVisible="False"
                            BackgroundColor="White">
                            <Button
                                Text="Silent"
                                Clicked="OnModeOptionClicked"
                                BackgroundColor="#F7F7F7"
                                TextColor="Black"/>
                            <Button
                                Text="Vibrate"
                                Clicked="OnModeOptionClicked"
                                BackgroundColor="#F7F7F7"
                                TextColor="Black"/>
                            <Button
                                Text="Normal"
                                Clicked="OnModeOptionClicked"
                                BackgroundColor="#F7F7F7"
                                TextColor="Black"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Entry
                        x:Name="PlaceRadiusEntry"
                        Placeholder="Radius in meters"
                        Keyboard="Numeric"
                        Focused="OnPlaceFormInputFocused"
                        Unfocused="OnPlaceFormInputUnfocused"
                        BackgroundColor="White"
                        TextColor="Black"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button
                            x:Name="PlaceFormCancelButton"
                            Text="Cancel"
                            Clicked="OnCancelPlaceFormClicked"
                            BackgroundColor="#EEEEEE"
                            TextColor="Black"/>

                        <Button
                            x:Name="PlaceFormSaveButton"
                            Grid.Column="1"
                            Text="Save"
                            Clicked="OnSavePlaceFormClicked"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </Grid>

    </Grid>

</ContentPage>
