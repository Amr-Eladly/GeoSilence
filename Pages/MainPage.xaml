<?xml version="1.0" encoding="utf-8" ?>
<ContentPage  
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"  
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"  
    xmlns:pageModels="clr-namespace:GeoSilence.PageModels" 
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    xmlns:conv="clr-namespace:GeoSilence.Converters"
    xmlns:models="clr-namespace:GeoSilence.Models"
    x:Class="GeoSilence.Pages.MainPage"  
    x:DataType="pageModels:HomeViewModel"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <!-- MAP (background) -->
        <maps:Map 
        x:Name="MainMap"
        IsShowingUser="True"
        MapClicked="OnMapClicked"/>

        <Grid
            x:Name="SearchPanel"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="8"
            Margin="10,8,68,0"
            HeightRequest="48"
            VerticalOptions="Start"
            ZIndex="1">

            <Border
                BackgroundColor="White"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                HeightRequest="48">

                <SearchBar
                    x:Name="PlaceSearchBar"
                    Placeholder="Search place..."
                    SearchButtonPressed="OnSearchSubmitted"
                    BackgroundColor="Transparent"
                    TextColor="Black"
                    PlaceholderColor="Gray"
                    CancelButtonColor="Gray"
                    FontSize="13"
                    HeightRequest="48"/>
            </Border>

            <Button
                x:Name="AddSearchResultButton"
                Grid.Column="1"
                Text="Add"
                IsVisible="False"
                Clicked="OnAddSearchResultClicked"
                BackgroundColor="White"
                TextColor="Black"
                Padding="16,0"/>
        </Grid>

        <Frame
            x:Name="PlacesBottomSheet"
            Margin="0"
            Padding="16,10,16,14"
            BackgroundColor="White"
            CornerRadius="24"
            HasShadow="True"
            HeightRequest="160"
            VerticalOptions="End"
            ZIndex="1">

            <Frame.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnBottomSheetPanUpdated"/>
            </Frame.GestureRecognizers>

            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                <BoxView
                    x:Name="BottomSheetHandle"
                    WidthRequest="42"
                    HeightRequest="4"
                    CornerRadius="2"
                    BackgroundColor="#D0D0D0"
                    HorizontalOptions="Center">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBottomSheetHandleTapped"/>
                    </BoxView.GestureRecognizers>
                </BoxView>

                <Label
                    Grid.Row="1"
                    Text="Places Near Me"
                    FontSize="18"
                    FontAttributes="Bold"/>

                <CollectionView
                    Grid.Row="2"
                    ItemsSource="{Binding NearbyPlaces}"
                    SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Place">

                            <SwipeView>

                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">

                                        <SwipeItemView
                                            CommandParameter="{Binding .}"
                                            Invoked="OnDeleteSwipe">
                                            <Grid
                                                WidthRequest="56"
                                                BackgroundColor="#D92D20">
                                                <Label
                                                    Text="🗑"
                                                    FontSize="16"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"/>
                                            </Grid>
                                        </SwipeItemView>

                                        <SwipeItemView
                                            CommandParameter="{Binding .}"
                                            Invoked="OnEditSwipe">
                                            <Grid
                                                WidthRequest="56"
                                                BackgroundColor="#2563EB">
                                                <Label
                                                    Text="⚙"
                                                    FontSize="16"
                                                    TextColor="White"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"/>
                                            </Grid>
                                        </SwipeItemView>

                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Grid
                                    Padding="4,10"
                                    ColumnDefinitions="*,Auto"
                                    RowDefinitions="Auto,Auto">

                                    <Label
                                        Text="{Binding Name}"
                                        FontSize="16"
                                        LineBreakMode="TailTruncation"/>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Mode}"
                                        TextColor="Gray"
                                        FontSize="13"/>

                                    <Label
                                        Grid.Row="1"
                                        Text="{Binding DistanceFormatted}"
                                        TextColor="Gray"
                                        FontSize="12"/>

                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{Binding Radius, StringFormat='{0:F0} m'}"
                                        TextColor="Gray"
                                        FontSize="12"/>
                                </Grid>

                            </SwipeView>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </Grid>
        </Frame>

        <Grid
            x:Name="PlaceFormOverlay"
            IsVisible="False"
            InputTransparent="False"
            BackgroundColor="#66000000"
            ZIndex="10">

            <Frame
                x:Name="PlaceFormCard"
                Margin="20,20,20,184"
                Padding="18"
                BackgroundColor="White"
                CornerRadius="20"
                HasShadow="True"
                VerticalOptions="End">

                <VerticalStackLayout Spacing="12">
                    <Label
                        x:Name="PlaceFormTitle"
                        Text="Add Place"
                        FontSize="20"
                        FontAttributes="Bold"/>

                    <Entry
                        x:Name="PlaceNameEntry"
                        Placeholder="Place name"
                        Focused="OnPlaceFormInputFocused"
                        Unfocused="OnPlaceFormInputUnfocused"
                        BackgroundColor="White"
                        TextColor="Black"/>

                    <VerticalStackLayout Spacing="0">
                        <Button
                            x:Name="PlaceModeButton"
                            Text="Silent"
                            Clicked="OnModeDropdownClicked"
                            BackgroundColor="White"
                            BorderColor="#DDDDDD"
                            BorderWidth="1"
                            TextColor="Black"
                            HorizontalOptions="Fill"/>

                        <VerticalStackLayout
                            x:Name="PlaceModeDropdown"
                            IsVisible="False"
                            BackgroundColor="White">
                            <Button
                                Text="Silent"
                                Clicked="OnModeOptionClicked"
                                BackgroundColor="#F7F7F7"
                                TextColor="Black"/>
                            <Button
                                Text="Vibrate"
                                Clicked="OnModeOptionClicked"
                                BackgroundColor="#F7F7F7"
                                TextColor="Black"/>
                            <Button
                                Text="Normal"
                                Clicked="OnModeOptionClicked"
                                BackgroundColor="#F7F7F7"
                                TextColor="Black"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Entry
                        x:Name="PlaceRadiusEntry"
                        Placeholder="Radius in meters"
                        Keyboard="Numeric"
                        Focused="OnPlaceFormInputFocused"
                        Unfocused="OnPlaceFormInputUnfocused"
                        BackgroundColor="White"
                        TextColor="Black"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button
                            Text="Cancel"
                            Clicked="OnCancelPlaceFormClicked"
                            BackgroundColor="#EEEEEE"
                            TextColor="Black"/>

                        <Button
                            Grid.Column="1"
                            Text="Save"
                            Clicked="OnSavePlaceFormClicked"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </Grid>

    </Grid>

</ContentPage>
