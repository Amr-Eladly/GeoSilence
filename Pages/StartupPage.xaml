<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="GeoSilence.Pages.StartupPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F8F7FC, Dark=#111116}">
    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="18">
        <Label Text="GeoSilence" FontSize="28" FontAttributes="Bold" HorizontalTextAlignment="Center"
               TextColor="{AppThemeBinding Light={StaticResource MapText}, Dark={StaticResource MapTextDark}}"/>
        <ActivityIndicator IsRunning="True" Color="{StaticResource MapPrimary}"/>
    </VerticalStackLayout>
</ContentPage>
