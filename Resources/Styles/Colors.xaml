<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#512BD4</Color>
    <!-- Map and Places semantic palette. -->
    <Color x:Key="MapPrimary">#6D28D9</Color>
    <Color x:Key="MapPrimaryDark">#A78BFA</Color>
    <Color x:Key="MapPrimaryPressed">#5B21B6</Color>
    <Color x:Key="MapSurface">#FFFFFF</Color>
    <Color x:Key="MapSurfaceDark">#18181E</Color>
    <Color x:Key="MapInput">#F5F3FF</Color>
    <Color x:Key="MapInputDark">#202028</Color>
    <Color x:Key="MapText">#111318</Color>
    <Color x:Key="MapTextDark">#F4F4F6</Color>
    <Color x:Key="MapSecondaryText">#6F6F7D</Color>
    <Color x:Key="MapSecondaryTextDark">#B0AFBA</Color>
    <Color x:Key="MapOutline">#E8E8ED</Color>
    <Color x:Key="MapOutlineDark">#30303A</Color>
    <Color x:Key="MapIconContainer">#EDE9FE</Color>
    <Color x:Key="MapIconContainerDark">#302255</Color>
    <Color x:Key="MapSelectedSurface">#FDFCFF</Color>
    <Color x:Key="MapSelectedSurfaceDark">#211A35</Color>
    <Color x:Key="MapSelectedOutline">#BFA7F5</Color>
    <Color x:Key="MapSelectedOutlineDark">#8B5CF6</Color>
    <Color x:Key="MapDanger">#E92929</Color>
    <Color x:Key="MapSilent">#20A447</Color>
    <Color x:Key="MapSilentContainer">#EAF8EE</Color>
    <Color x:Key="MapSilentContainerDark">#173726</Color>
    <Color x:Key="MapVibrate">#E69208</Color>
    <Color x:Key="MapVibrateContainer">#FFF4DE</Color>
    <Color x:Key="MapVibrateContainerDark">#423019</Color>
    <Color x:Key="MapRing">#737381</Color>
    <Color x:Key="MapRingContainer">#F1F1F3</Color>
    <Color x:Key="MapRingContainerDark">#33333B</Color>
    <Color x:Key="PrimaryDark">#ac99ea</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <Color x:Key="DarkBackground">#17171a</Color>
    <Color x:Key="LightOnDarkBackground">#C3C3C3</Color>
    <Color x:Key="LightBackground">#F2F2F2</Color>
    <Color x:Key="DarkOnLightBackground">#0D0D0D</Color>

    <Color x:Key="LightSecondaryBackground">#E0E0E0</Color>
    <Color x:Key="DarkSecondaryBackground">#222228</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
