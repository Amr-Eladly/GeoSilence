rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasExactFields(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function validProfile(userId) {
      let data = request.resource.data;

      return hasExactFields(data, [
        'uid',
        'displayName',
        'email',
        'firstName',
        'lastName',
        'dateOfBirth',
        'photoUrl',
        'photoStoragePath',
        'createdAt',
        'updatedAt'
      ])
      && data.uid == userId
      && data.uid == request.auth.uid
      && data.displayName is string
      && data.displayName.size() <= 120
      && data.email is string
      && data.email.size() > 0
      && data.email.size() <= 320
      && data.firstName is string
      && data.firstName.size() <= 100
      && data.lastName is string
      && data.lastName.size() <= 100
      && data.dateOfBirth is string
      && data.dateOfBirth.size() <= 10
      && data.photoUrl is string
      && data.photoUrl.size() <= 2048
      && data.photoStoragePath is string
      && data.photoStoragePath.size() <= 512
      && data.createdAt is timestamp
      && data.updatedAt is timestamp
      && data.updatedAt >= data.createdAt;
    }

    function validPlaceValues(data, placeId, userId) {
      return data.id == placeId
      && data.id is string
      && data.id.size() > 0
      && data.id.size() <= 128
      && data.ownerId == userId
      && data.ownerId == request.auth.uid
      && data.name is string
      && data.name.size() > 0
      && data.name.size() <= 120
      && data.latitude is number
      && data.latitude >= -90
      && data.latitude <= 90
      && data.longitude is number
      && data.longitude >= -180
      && data.longitude <= 180
      && data.radius is number
      && data.radius >= 25
      && data.radius <= 5000
      && data.mode in ['Silent', 'Vibrate', 'Normal']
      && data.activationType in ['Automatic', 'ConfirmFirst']
      && data.placeType in ['Education', 'Religious', 'Work', 'Hospital', 'Other']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp
      && data.updatedAt >= data.createdAt;
    }

    function validPrivatePlace(userId, placeId) {
      let data = request.resource.data;

      return hasExactFields(data, [
        'id',
        'ownerId',
        'name',
        'latitude',
        'longitude',
        'radius',
        'mode',
        'activationType',
        'placeType',
        'visibility',
        'deleted',
        'createdAt',
        'updatedAt',
        'version'
      ])
      && validPlaceValues(data, placeId, userId)
      && data.visibility == 'Private'
      && data.deleted is bool
      && data.version is int
      && data.version >= 1;
    }

    function validPublicPlace(placeId) {
      let data = request.resource.data;

      return hasExactFields(data, [
        'id',
        'ownerId',
        'name',
        'latitude',
        'longitude',
        'radius',
        'mode',
        'activationType',
        'placeType',
        'createdAt',
        'updatedAt'
      ])
      && validPlaceValues(data, placeId, request.auth.uid);
    }

    match /users/{userId} {
      allow create: if isOwner(userId) && validProfile(userId);
      allow get: if isOwner(userId);
      allow update: if isOwner(userId)
        && validProfile(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt >= resource.data.updatedAt;
      allow delete: if isOwner(userId);
      allow list: if false;

      match /places/{placeId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && validPrivatePlace(userId, placeId);
        allow update: if isOwner(userId)
          && validPrivatePlace(userId, placeId)
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt >= resource.data.updatedAt
          && request.resource.data.version >= resource.data.version;
        allow delete: if isOwner(userId)
          && resource.data.ownerId == request.auth.uid;
      }
    }

    match /publicPlaces/{placeId} {
      allow get, list: if signedIn();

      allow create: if signedIn()
        && validPublicPlace(placeId);

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && validPublicPlace(placeId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt >= resource.data.updatedAt;

      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
